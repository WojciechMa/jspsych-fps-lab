{
  "name": "jspsych-fps-lab",
  "version": "0.0.3",
  "private": true,
  "description": "Behavioral experiments on the Doom engine, run as jsPsych trials in the browser.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:engine": "node scripts/build-engine.mjs",
    "build:miniwad": "node scripts/build-miniwad.mjs",
    "build:maps": "node scripts/build-maps.mjs",
    "fetch:freedoom": "node scripts/fetch-freedoom.mjs",
    "build:iwad": "node scripts/build-iwad.mjs",
    "build:jatos": "npm run build && node scripts/build-jatos.mjs",
    "jatos:local": "node scripts/jatos-local.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@jspsych/plugin-browser-check": "^2.1.0",
    "@jspsych/plugin-fullscreen": "^2.1.0",
    "@jspsych/plugin-html-button-response": "^2.1.0",
    "@jspsych/plugin-survey-likert": "^2.2.0",
    "@jspsych/plugin-survey-multi-choice": "^2.2.1",
    "@jspsych/plugin-survey-multi-select": "^2.1.1",
    "@jspsych/plugin-survey-text": "^2.1.1",
    "jspsych": "^8.3.0"
  }
}
